M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_MAILBOX=
M365_MAIL_FOLDER=inbox
M365_ALLOWED_SENDERS=

KUMA_PUSH_URL=
KUMA_AUTO_CREATE_MONITOR=false
KUMA_BASE_URL=
KUMA_JWT_TOKEN=
KUMA_USERNAME=
KUMA_PASSWORD=
KUMA_MFA_TOKEN=
KUMA_MONITOR_NAME_TEMPLATE=Synology Backup - {job_name}
KUMA_MONITOR_DESCRIPTION_TEMPLATE=
KUMA_MONITOR_INTERVAL_SECONDS=93600
KUMA_MONITOR_RETRY_INTERVAL_SECONDS=600
KUMA_MONITOR_RESEND_INTERVAL_SECONDS=0
KUMA_MONITOR_MAX_RETRIES=0

SUCCESS_PATTERNS=["completed successfully","er fuldført","completed backup of"]
FAILURE_PATTERNS=["delvist gennemført","\\bfailed\\b","\\berror\\b","destination disk is full","backup task.*aborted"]

POLL_INTERVAL_SECONDS=300
BOOTSTRAP_LOOKBACK_HOURS=72
STATE_FILE=./data/state.json
GRAPH_TIMEOUT_SECONDS=30
KUMA_TIMEOUT_SECONDS=15
MAX_MESSAGES=50
LOG_LEVEL=INFO
PUSH_PENDING_ON_START=false

MONITOR_ENABLED=true
MONITOR_HOST=0.0.0.0
MONITOR_PORT=8080
MONITOR_USERNAME=monitor
MONITOR_PASSWORD=
MONITOR_TITLE=Backup Mail Monitor
